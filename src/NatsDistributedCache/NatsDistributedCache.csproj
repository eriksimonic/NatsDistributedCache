<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>NatsDistributedCache</RootNamespace>
    <Description>Two-level cache (in-process L1, NATS JetStream KV L2) with cluster-wide single-flight and invalidation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NatsDistributedCache.UnitTests" />
    <InternalsVisibleTo Include="NatsDistributedCache.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="NATS.Net" Version="3.3.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="../Shared/IsExternalInit.cs" Link="Shared/IsExternalInit.cs" />
  </ItemGroup>
</Project>
